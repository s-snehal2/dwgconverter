# Local environment — secrets and machine-specific settings.
# Only .env.example templates are tracked.
.env*
!.env.example
**/.env*
!**/.env.example

# Editor / agent tooling local to this machine
.opencode/

# Runtime temp files (uploaded DWGs + converted outputs)
/temp/
frontend/temp/

# OS
.DS_Store
Thumbs.db
*.pem

# Package managers (pnpm / yarn artifacts)
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
coverage/

# Node / Next build output
node_modules/
.next/
out/
build/

# Logs
*.log

# TypeScript / Next.js generated
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel
