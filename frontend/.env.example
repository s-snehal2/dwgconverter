# ============================================================
# DWG → PNG Converter — environment configuration
#
# Next.js automatically loads a `.env` file from this directory.
# To use: copy this file to `.env` and edit the values you want
# to change. Leave most lines at their defaults.
# ============================================================

# Directory for staged uploads and outputs. Relative to this folder
# (frontend/), so temp files land in ./temp by default.
TEMP_DIR=./temp

# Maximum DWG upload size, in megabytes.
MAX_FILE_SIZE_MB=80

# Maximum sheets converted from one DWG. Every renderable layout becomes its own
# PNG; a DWG with more *layouts* than this is rejected as "multi-sheet exceeds
# limit". Model-space crops share the same budget and are merged down to
# whatever the layouts leave over, so no drawing content is ever dropped.
MAX_LAYOUTS=100

# Second-stage blank test, applied only to sheets that already pass the semantic
# check (a sheet whose viewport frames model drawing). Sheets under this ink
# coverage are dropped too, catching a sheet that holds geometry yet still
# renders nearly empty. Measured on the rendered image, so 0.005 = "less than
# half a percent of the page is drawn".
#
# The semantic check is not configurable: a sheet produces no PNG unless it
# actually shows a drawing, i.e. model geometry inside a layout's viewport (or
# real geometry in a model crop). A sheet with no viewport, an empty viewport,
# or nothing but text and points is always dropped.
#
# Dropped sheets are listed with their reason in the note under the results.
# Raise the threshold if a real but very sparse drawing is being discarded; a
# DWG where every sheet is dropped is rejected with "no drawable content".
# BLANK_SHEET_INK_FRACTION=0.005

# Model-space drawings are told apart by whitespace. A gap smaller than this
# fraction of the overall model size counts as internal detail, so a dense
# drawing stays one crop instead of being shredded into unreadable tiles.
# Lower it to split more eagerly, raise it to keep drawings together.
MODEL_CLUSTER_GAP_FRACTION=0.03

# Recursion ceiling for model clustering. Caps the worst-case crop count.
MODEL_CLUSTER_MAX_DEPTH=12

# Maximum output PNG width/height, in pixels.
MAX_PNG_DIMENSION=3000

# Oversample factor for anti-aliased output (2 = render at 2x, downscale to fit).
PNG_SUPERSAMPLE=2

# Minimum stroke thickness in pixels, so thin CAD lines stay visible.
MIN_STROKE_PX=1

# Padding (margin) around the drawing, in pixels.
MARGIN_PX=50

# Age (in minutes) after which converted outputs are swept. Default 43200 = 30
# days: results stay downloadable/previewable for that window (storage grows
# with conversion volume on Vercel Blob).
CLEANUP_AGE_MINUTES=43200

# Age (in minutes) kept for the AI-image cache. When the same drawing is
# converted again within this window, its earlier generated image is reused
# instead of calling Gemini. Default 43200 = 30 days.
CACHE_AGE_MINUTES=43200

# Per-IP convert requests allowed per minute.
RATE_LIMIT_PER_MINUTE=30

# ------------------------------------------------------------------
# AI image generation (Gemini 3.1 Flash / Nano Banana 2)
#
# Set GEMINI_API_KEY to enable the "Generate AI image" button.
# Leave it empty to keep the feature disabled.
# ------------------------------------------------------------------
# GEMINI_API_KEY=

# Model used for AI image generation.
GEMINI_MODEL=gemini-3.1-flash-image

# Maximum time (in milliseconds) Gemini may take to produce an image.
# Default 240000 (240s), leaving room under Vercel's 300s function limit.
# GEMINI_TIMEOUT_MS=240000

# Maximum length of the user-supplied AI prompt (characters). Prompts longer
# than this are rejected with a friendly error.
# MAX_AI_PROMPT_CHARS=1000

# Maximum AI image generations per converted drawing (default 3). Reusing an
# earlier generated image (cache hit) does not consume a generation.
AI_GENERATION_LIMIT=3

# OPTIONAL: override the built-in prompt sent to Gemini.
# Leave empty to use the built-in architectural-visualization prompt.
# GEMINI_PROMPT=


# ------------------------------------------------------------------
# Rendering options
# ------------------------------------------------------------------
# Set to "color" for colored (layer-based) output; default is monochrome.
# COLOR_MODE=color

# ------------------------------------------------------------------
# TilesView room-planner upload (optional)
# Set TILESVIEW_APP_KEY + TILESVIEW_APP_SECRET to enable the
# "View in Visualizer" button after AI image generation.
# ------------------------------------------------------------------
TILESVIEW_API_URL=https://tilesview.ai/Provider/app/api-room-planner-data
# TILESVIEW_APP_KEY=
# TILESVIEW_APP_SECRET=

# Base URL of the TilesView visualizer app shown after a successful upload.
# The room id and "MySpace" path are appended automatically.
# TILESVIEW_VISUALIZER_BASE_URL=https://tilesview.ai/app/EZEnoscu4lODABbT_sHm7Q/visualizer

# TilesView auth header names (only change if the provider renames them).
# TILESVIEW_APP_KEY_HEADER=app_key
# TILESVIEW_APP_SECRET_HEADER=app_secret

# ------------------------------------------------------------------
# Vercel Cron cleanup (optional, production only)
# Set CRON_SECRET on Vercel so the daily /api/cleanup job is the only caller
# allowed to sweep expired outputs. Vercel sends it as a bearer token.
# CRON_SECRET=
