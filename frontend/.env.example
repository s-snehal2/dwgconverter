# ============================================================
# DWG → PNG Converter — environment configuration
#
# Next.js automatically loads a `.env` file from this directory.
# To use: copy this file to `.env` and edit the values you want
# to change. Leave most lines at their defaults.
# ============================================================

# Directory for outputs and the AI-image cache. Relative to this folder
# (frontend/), so temp files land in ./temp by default.
# Ignored entirely when Supabase credentials are set below, since the Supabase
# Storage bucket replaces local files.
TEMP_DIR=./temp

# ------------------------------------------------------------------
# Supabase Storage (production)
#
# Converted PNGs, AI images and the AI-image cache live in a *private* bucket,
# because a converted drawing must survive the convert -> preview -> generate
# -> download request flow on an ephemeral serverless filesystem.
#
# With these unset, the app falls back to writing TEMP_DIR on local disk — the
# normal setup for development and tests.
#
# SUPABASE_SERVICE_ROLE_KEY must stay server-side: it is a full-privilege key
# and is never sent to the browser. Prefer the new `sb_secret_...` format, which
# is scoped to the API and rotatable without changing the project.
#
# The variable names must match exactly: the server reads `SUPABASE_URL` (not
# `PUBLIC_SUPABASE_URL` or `NEXT_PUBLIC_SUPABASE_URL` — those are ignored and
# silently fall back to local disk storage). Set the same names on Vercel.
# ------------------------------------------------------------------
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
SUPABASE_STORAGE_BUCKET="dwg-files"

# Maximum DWG size the convert route accepts, in megabytes. Note the hosting
# platform's request-body cap (~4.5 MB) bites first: DWGs are uploaded as
# multipart to /api/convert, and the direct-to-storage path is removed.
MAX_FILE_SIZE_MB=80

# Maximum sheets converted from one DWG. Every renderable layout becomes its own
# PNG; a DWG with more *layouts* than this is rejected as "multi-sheet exceeds
# limit". Model-space crops share the same budget and are merged down to
# whatever the layouts leave over, so no drawing content is ever dropped.
MAX_LAYOUTS=100

# Blank-sheet dropping. OFF by default: every layout and every model crop
# becomes a PNG, so no drawing content can ever be silently lost. Set to "true"
# to drop sheets that show no drawing (no model geometry inside any viewport,
# or a model crop holding only text/points) and sheets under the ink threshold
# below. Dropped sheets are listed with their reason in the results note; a DWG
# where every sheet is dropped is rejected with "no drawable content".
# DROP_BLANK_SHEETS=false

# Second-stage blank test, applied only when DROP_BLANK_SHEETS=true and only
# to sheets that already pass the semantic check (a sheet whose viewport frames
# model drawing). Sheets under this ink coverage are dropped too, catching a
# sheet that holds geometry yet still renders nearly empty. Measured on the
# rendered image, so 0.005 = "less than half a percent of the page is drawn".
#
# Raise the threshold if a real but very sparse drawing is being discarded.
# BLANK_SHEET_INK_FRACTION=0.005

# Model-space drawings are told apart by whitespace. A gap smaller than this
# fraction of the overall model size counts as internal detail, so a dense
# drawing stays one crop instead of being shredded into unreadable tiles.
# Lower it to split more eagerly, raise it to keep drawings together.
MODEL_CLUSTER_GAP_FRACTION=0.03

# Recursion ceiling for model clustering. Caps the worst-case crop count.
MODEL_CLUSTER_MAX_DEPTH=12

# Maximum output PNG width/height, in pixels, for paper-space layout sheets.
# A layout frames one view of the model at 1:1 paper scale, so its labels are
# already far above a pixel and extra resolution buys nothing but bytes - a real
# 26-layout drawing measured 1.00x label inflation here, i.e. true DWG scale.
MAX_PNG_DIMENSION=4500

# Output size for model-space crops only; defaults to MAX_PNG_DIMENSION when
# unset. A model crop frames the WHOLE drawing, so its millimetre annotation
# scales to a small fraction of a pixel and the text floor below has to inflate
# it to stay visible. Measured on a real drawing: at 3000px the whole-model crop
# needed 47x inflation; raising only the crops to 6000px cut that to 13x, for
# about 1/12th of the extra PNG bytes a whole-DWG bump would cost.
MODEL_PNG_DIMENSION=6000

# Oversample factor for anti-aliased output (2 = render at 2x, downscale to fit).
PNG_SUPERSAMPLE=2

# Minimum stroke thickness in pixels, so thin CAD lines stay visible.
MIN_STROKE_PX=1

# Smallest text cap height, in output pixels. Labels are drawn at
# max(true size, this floor), so this is the one deliberate deviation from true
# DWG sizing in the renderer. Without a floor the text exists in the SVG but is
# invisible in the PNG: a 3-unit label on a 63,000-unit drawing is 0.15px at
# 3000px, and rendering it honestly would need an ~84,000px canvas.
# Measured on such a drawing: 26 of 27 paper-space layouts never reach this
# floor (1.00x inflation - already true scale); only model crops do, at ~13x with
# MODEL_PNG_DIMENSION=6000. Lower this to favour fidelity over legibility, and
# raise MODEL_PNG_DIMENSION alongside it.
MIN_TEXT_CAP_PX=4

# Largest cap height, in output pixels, any label is drawn at (48). The
# counterpart to MIN_TEXT_CAP_PX, and the safety net for the opposite failure:
# with STRICT_TEXT_SCALE on there is no floor, so text size is purely
# `entity.height x scale` and nothing upstream bounds it. A single mis-scaled
# height - notably dimension text whose stored height is 0 - otherwise rendered
# as type tens of times larger than the sheet. 48px of cap height (~69px font)
# sits far above any label genuinely part of a drawing, so correct text is
# untouched and only a runaway is clamped. Applies in both strict and non-strict
# modes.
# MAX_TEXT_CAP_PX=48

# Log a per-sheet text-fidelity audit on every conversion: how many of the
# strings the sheet is supposed to show reached the SVG, the smallest cap height
# emitted, and any label below the floor or with non-finite geometry. Turn this
# on when a drawing's text looks wrong - a sheet reads "exp=130 got=130" when
# every label survived, and lists the missing strings when one was dropped.
# AUDIT_TEXT=1

# Padding (margin) around the drawing, in pixels.
MARGIN_PX=50

# Age (in minutes) after which converted outputs are swept. Default 43200 = 30
# days: results stay downloadable/previewable for that window. Applies to the
# `outputs/` group in the bucket, and the on-disk dir in local dev.
CLEANUP_AGE_MINUTES=43200

# How long a cached AI image stays reusable, in minutes. When the same drawing
# is converted again within this window, its earlier generated image is reused
# instead of calling Gemini. Default 43200 = 30 days. Requires Supabase; without
# it there is no bucket, so the cache is skipped and every request calls Gemini.
CACHE_AGE_MINUTES=43200

# Age (in minutes) after which a staged inbound DWG is swept. An upload is
# deleted as soon as its conversion finishes, so anything still present is debris
# from a crashed or timed-out conversion — keep this window short. Default 60.
UPLOAD_AGE_MINUTES=60

# Per-IP convert requests allowed per minute.
RATE_LIMIT_PER_MINUTE=30

# ------------------------------------------------------------------
# AI image generation (Gemini 3.1 Flash / Nano Banana 2)
#
# Set GEMINI_API_KEY to enable the "Generate AI image" button.
# Leave it empty to keep the feature disabled.
# ------------------------------------------------------------------
# GEMINI_API_KEY=

# Model used for AI image generation.
GEMINI_MODEL=gemini-3.1-flash-image

# Maximum time (in milliseconds) Gemini may take to produce an image.
# Default 240000 (240s), leaving room under Vercel's 300s function limit.
# GEMINI_TIMEOUT_MS=240000

# Maximum AI image generations per conversion (default 3). `0` means
# unlimited: reuse is decided by the AI pair cache, not by a counter.
# Set a positive number to cap generations and have the counter enforced.
# AI_GENERATION_LIMIT=3

# OPTIONAL: override the built-in prompt sent to Gemini.
# When set, this wins over DEFAULT_GEMINI_PROMPT in server/config.ts — including
# in production, so a stale value here will silently ignore any prompt edit.
# Leave empty to use the built-in architectural-visualization prompt.
# GEMINI_PROMPT=


# ------------------------------------------------------------------
# Rendering options
# ------------------------------------------------------------------
# Monochrome (the default) draws black line work and black labels, and paints
# substantial filled regions light grey so highlights still read as highlights.
# Set to "color" only to keep each entity's resolved DWG color.
# COLOR_MODE=color

# ------------------------------------------------------------------
# TilesView room-planner upload (optional)
# Set TILESVIEW_APP_KEY + TILESVIEW_APP_SECRET to enable the
# "View in Visualizer" button after AI image generation.
# ------------------------------------------------------------------
TILESVIEW_API_URL=https://tilesview.ai/Provider/app/api-room-planner-data
# TILESVIEW_APP_KEY=
# TILESVIEW_APP_SECRET=

# Base URL of the TilesView visualizer app shown after a successful upload.
# The room id and "MySpace" path are appended automatically.
# TILESVIEW_VISUALIZER_BASE_URL=https://tilesview.ai/app/EZEnoscu4lODABbT_sHm7Q/visualizer

# TilesView auth header names (only change if the provider renames them).
# TILESVIEW_APP_KEY_HEADER=app_key
# TILESVIEW_APP_SECRET_HEADER=app_secret

# ------------------------------------------------------------------
# Vercel Cron cleanup (optional, production only)
# Set CRON_SECRET on Vercel so the daily /api/cleanup job is the only caller
# allowed to sweep expired objects in the Supabase bucket. Vercel sends it as a
# bearer token. Without it the route returns 401 and the *scheduled* sweep never
# runs; expired objects are still reclaimed opportunistically by the throttled
# sweep on the convert, generate and download paths (at most once per 10 min per
# process), so set it if you want a guaranteed daily pass.
# CRON_SECRET=

# Draw labels at their true DWG size (true, the default) or enforce a minimum
# readable cap height in output pixels (false).
#
# `true` is what keeps the render geometrically faithful: a 2.5mm annotation on a
# large sheet is genuinely sub-pixel, and MIN_TEXT_CAP_PX would inflate it into a
# label the source drawing does not contain. Set `false` only if the sheets you
# convert have annotations too small to survive downscaling.
#
# Note the ceiling still applies either way - see MAX_TEXT_CAP_PX above. The two
# settings bound opposite ends of the same problem, and neither one alone is
# enough: strict mode has no floor, so it needs the cap.
STRICT_TEXT_SCALE=true
